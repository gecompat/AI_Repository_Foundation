{
  "schema_version": 1,
  "ruleset_version": "1.1.0",
  "description": "Explicit whitelist of reusable rules that may be transferred to another repository.",
  "default_adapters": ["github-copilot", "claude-code", "gemini"],
  "core": [
    {"source": "foundation/AGENTS.template.md", "target": "AGENTS.md", "kind": "entrypoint", "merge": "ai_merge_if_exists"},
    {"source": "foundation/FOUNDATION_RULESET.template.md", "target": ".ai/foundation/FOUNDATION_RULESET.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/PROJECT_RULES.md", "target": ".ai/foundation/PROJECT_RULES.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/WORKING_RULES.md", "target": ".ai/foundation/WORKING_RULES.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/MODEL_ROUTING_POLICY.md", "target": ".ai/foundation/MODEL_ROUTING_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/VALIDATION_POLICY.md", "target": ".ai/foundation/VALIDATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DATA_PRIVACY_AND_CONFIDENTIALITY.md", "target": ".ai/foundation/DATA_PRIVACY_AND_CONFIDENTIALITY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/SECURITY_AND_SAFE_OPERATIONS.md", "target": ".ai/foundation/SECURITY_AND_SAFE_OPERATIONS.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DOCUMENTATION_POLICY.md", "target": ".ai/foundation/DOCUMENTATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/THIRD_PARTY_AND_LICENSING.md", "target": ".ai/foundation/THIRD_PARTY_AND_LICENSING.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/SOURCE_AND_EVIDENCE_POLICY.md", "target": ".ai/foundation/SOURCE_AND_EVIDENCE_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DEPENDENCY_POLICY.md", "target": ".ai/foundation/DEPENDENCY_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "foundation/repo_map.template.yaml", "target": ".ai/foundation/repo_map.yaml", "kind": "rule-index", "merge": "review_if_exists"}
  ],
  "adapters": {
    "github-copilot": [{"source": ".github/copilot-instructions.md", "target": ".github/copilot-instructions.md", "kind": "adapter", "merge": "ai_merge_if_exists"}],
    "claude-code": [{"source": "CLAUDE.md", "target": "CLAUDE.md", "kind": "adapter", "merge": "ai_merge_if_exists"}],
    "gemini": [{"source": "GEMINI.md", "target": "GEMINI.md", "kind": "adapter", "merge": "ai_merge_if_exists"}]
  },
  "never_transfer": [
    "README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", ".gitignore",
    ".ai/PROJECT_CONTEXT.md", ".ai/FOUNDATION.md", ".ai/PROJECT_STATUS.md", ".ai/HANDOVER.md", ".ai/BACKLOG.md", ".ai/ROADMAP.md", ".ai/TOOL_ADAPTERS.yaml", ".ai/repo_map.yaml",
    "Documentation/Architecture/", "Documentation/Quality/", "tools/", "tests/"
  ]
}
