{
  "schema_version": 1,
  "ruleset_version": "1.4.0",
  "installation_scope": "core_rules_with_opt_in_capabilities",
  "source_license": "MIT",
  "target_root_license_behavior": "never_modify_or_replace",
  "description": "Explicit whitelist of reusable core rules/provenance plus explicitly selected optional capability files for new or existing repositories.",
  "default_adapters": ["github-copilot", "claude-code", "gemini"],
  "default_capabilities": [],
  "transfer_coverage_contract": {
    "version_authority": "foundation/manifest.json#ruleset_version",
    "version_mirrors": [
      {"path": ".ai/FOUNDATION.md", "pattern": "(?m)^- version: (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"},
      {"path": ".ai/PROJECT_STATUS.md", "pattern": "(?m)^Foundation version: (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)(?: candidate)?$"},
      {"path": "foundation/FOUNDATION_RULESET.template.md", "pattern": "(?m)^Ruleset version: (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"},
      {"path": "foundation/repo_map.template.yaml", "pattern": "(?m)^foundation_ruleset_version: (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"},
      {"path": "CHANGELOG.md", "pattern": "(?m)^## \\[(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\\] -"}
    ],
    "managed_core_roots": [
      {"path": "Documentation/Standards", "suffixes": [".md"], "recursive": false},
      {"path": "foundation/schemas", "suffixes": [".json"], "recursive": true}
    ],
    "fixed_core_sources": [
      "foundation/AGENTS.template.md",
      "foundation/FOUNDATION_RULESET.template.md",
      "foundation/AI_REPOSITORY_FOUNDATION_NOTICE.md",
      ".ai/PROJECT_RULES.md",
      ".ai/WORKING_RULES.md",
      ".ai/MODEL_ROUTING_POLICY.md",
      ".ai/VALIDATION_POLICY.md",
      "foundation/repo_map.template.yaml"
    ],
    "legacy_capability_roots": [
      {"capability": "artifact-registration-clients", "path": "tools/identity", "suffixes": [".py", ".ps1"], "recursive": true}
    ],
    "future_capability_root": "foundation/capabilities",
    "future_transferable_policy_root": "Documentation/Standards",
    "future_transferable_schema_root": "foundation/schemas",
    "unclassified_managed_source_behavior": "blocking"
  },
  "integration_contract": {
    "policy_source": "Documentation/Standards/SEMANTIC_INTEGRATION_POLICY.md",
    "policy_target": ".ai/foundation/SEMANTIC_INTEGRATION_POLICY.md",
    "root_entrypoint": "AGENTS.md",
    "project_governance_must_be_transitively_discoverable": true,
    "stricter_project_rules": "compatible",
    "existing_project_rule_labels_required": false,
    "adapter_governance_migration": "preserve_then_rehome_then_thin",
    "project_repo_map_behavior": "preserve_and_optionally_bridge",
    "orphaned_authority_is_integration_defect": true,
    "compatibility_classes": [
      "EQUIVALENT",
      "PROJECT_STRONGER",
      "PROJECT_SELECTABLE_OVERRIDE",
      "COMPLEMENTARY",
      "DUPLICATE_GOVERNANCE",
      "FOUNDATION_REQUIRED_CONFLICT",
      "TARGET_INTERNAL_CONFLICT",
      "ORPHANED_AUTHORITY",
      "ADAPTER_GOVERNANCE_MISPLACED"
    ]
  },
  "identity_contract": {
    "policy_source": "Documentation/Standards/PERSISTENT_IDENTITY_POLICY.md",
    "policy_target": ".ai/foundation/PERSISTENT_IDENTITY_POLICY.md",
    "required_invariants": [
      "stable_no_reuse",
      "no_silent_rename_or_reinterpretation",
      "legacy_identifier_preservation",
      "identity_separate_from_mutable_classification",
      "relationships_explicit",
      "revision_identity_separate",
      "identifiers_are_not_authorization"
    ],
    "default_machine_identifier": "rfc9562_uuidv7_as_urn_uuid",
    "compatible_uuid_profiles": ["uuidv7", "uuidv4"],
    "default_human_reference": "flat_typed_project_local",
    "default_human_reference_pattern": "<PREFIX>-<SEQUENCE>",
    "default_prefixes": ["CAP", "REQ", "WI", "DEC", "GATE", "RISK", "EXP", "OPS", "INC", "REL", "TEST"],
    "prefix_meaning_reuse": "prohibited",
    "hierarchy_and_status": "metadata_not_canonical_identity",
    "external_references": "aliases_or_locators_not_canonical_by_default",
    "content_hash_scope": "immutable_revision_or_content",
    "existing_project_default_mode": "PRESERVE",
    "new_project_default_mode": "FOUNDATION_DEFAULT",
    "adoption_modes": ["PRESERVE", "ADOPT_FORWARD", "MIGRATE_EXPLICIT"],
    "migration_requires_explicit_decision": true,
    "unknown_existing_project_choice": "PRESERVE"
  },
  "registration_contract": {
    "policy_source": "Documentation/Standards/ARTIFACT_REGISTRATION_POLICY.md",
    "policy_target": ".ai/foundation/ARTIFACT_REGISTRATION_POLICY.md",
    "schema_targets": [
      ".ai/foundation/schemas/artifact-record.schema.json",
      ".ai/foundation/schemas/artifact-registry.schema.json",
      ".ai/foundation/schemas/artifact-registration-request.schema.json"
    ],
    "authority_scope": "one_registration_authority_per_overlapping_identifier_scope",
    "same_authority_for_humans_and_ai": true,
    "implementation_language": "project_selectable",
    "python_required": false,
    "powershell_supported": true,
    "allocation_modes": ["DIRECT", "DEFERRED"],
    "direct_requires_serialized_or_equivalent_unique_allocation": true,
    "deferred_uid_is_final_before_human_reference": true,
    "final_human_reference_must_be_authority_allocated": true,
    "reference_clients": "optional_capability",
    "reference_clients_must_match_shared_contract": true
  },
  "validation_contract": {
    "foundation_validator_scope": "FOUNDATION_INTEGRITY",
    "project_semantic_authority": "target_repository",
    "runtime_empirical_authority": "target_repository",
    "completion": "impact_based_combination",
    "foundation_green_does_not_imply_project_green": true,
    "foundation_reserved_statuses": ["not executed", "pending manual validation", "validated"],
    "target_status_extensions_allowed": true,
    "reserved_statuses_may_not_be_redefined": true
  },
  "model_routing_contract": {
    "foundation_tiers": ["LOCAL", "ECONOMICAL", "BALANCED", "FRONTIER"],
    "target_policy_may_be_more_detailed": true,
    "semantic_mapping_required_when_overlapping": true,
    "concrete_models_are_runtime_facts": true
  },
  "attribution": {
    "required": true,
    "source": "foundation/AI_REPOSITORY_FOUNDATION_NOTICE.md",
    "target": ".ai/foundation/AI_REPOSITORY_FOUNDATION_NOTICE.md",
    "policy": "preserve_complete_notice_without_changing_target_root_license"
  },
  "core": [
    {"source": "foundation/AGENTS.template.md", "target": "AGENTS.md", "kind": "entrypoint", "merge": "ai_merge_if_exists"},
    {"source": "foundation/FOUNDATION_RULESET.template.md", "target": ".ai/foundation/FOUNDATION_RULESET.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "foundation/AI_REPOSITORY_FOUNDATION_NOTICE.md", "target": ".ai/foundation/AI_REPOSITORY_FOUNDATION_NOTICE.md", "kind": "attribution", "merge": "review_if_exists"},
    {"source": ".ai/PROJECT_RULES.md", "target": ".ai/foundation/PROJECT_RULES.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/SEMANTIC_INTEGRATION_POLICY.md", "target": ".ai/foundation/SEMANTIC_INTEGRATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/PERSISTENT_IDENTITY_POLICY.md", "target": ".ai/foundation/PERSISTENT_IDENTITY_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/ARTIFACT_REGISTRATION_POLICY.md", "target": ".ai/foundation/ARTIFACT_REGISTRATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "foundation/schemas/artifact-record.schema.json", "target": ".ai/foundation/schemas/artifact-record.schema.json", "kind": "schema", "merge": "review_if_exists"},
    {"source": "foundation/schemas/artifact-registry.schema.json", "target": ".ai/foundation/schemas/artifact-registry.schema.json", "kind": "schema", "merge": "review_if_exists"},
    {"source": "foundation/schemas/artifact-registration-request.schema.json", "target": ".ai/foundation/schemas/artifact-registration-request.schema.json", "kind": "schema", "merge": "review_if_exists"},
    {"source": ".ai/WORKING_RULES.md", "target": ".ai/foundation/WORKING_RULES.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/MODEL_ROUTING_POLICY.md", "target": ".ai/foundation/MODEL_ROUTING_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": ".ai/VALIDATION_POLICY.md", "target": ".ai/foundation/VALIDATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DATA_PRIVACY_AND_CONFIDENTIALITY.md", "target": ".ai/foundation/DATA_PRIVACY_AND_CONFIDENTIALITY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/SECURITY_AND_SAFE_OPERATIONS.md", "target": ".ai/foundation/SECURITY_AND_SAFE_OPERATIONS.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DOCUMENTATION_POLICY.md", "target": ".ai/foundation/DOCUMENTATION_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/THIRD_PARTY_AND_LICENSING.md", "target": ".ai/foundation/THIRD_PARTY_AND_LICENSING.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/SOURCE_AND_EVIDENCE_POLICY.md", "target": ".ai/foundation/SOURCE_AND_EVIDENCE_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "Documentation/Standards/DEPENDENCY_POLICY.md", "target": ".ai/foundation/DEPENDENCY_POLICY.md", "kind": "rule", "merge": "review_if_exists"},
    {"source": "foundation/repo_map.template.yaml", "target": ".ai/foundation/repo_map.yaml", "kind": "rule-index", "merge": "review_if_exists"}
  ],
  "adapters": {
    "github-copilot": [{"source": ".github/copilot-instructions.md", "target": ".github/copilot-instructions.md", "kind": "adapter", "merge": "ai_merge_if_exists"}],
    "claude-code": [{"source": "CLAUDE.md", "target": "CLAUDE.md", "kind": "adapter", "merge": "ai_merge_if_exists"}],
    "gemini": [{"source": "GEMINI.md", "target": "GEMINI.md", "kind": "adapter", "merge": "ai_merge_if_exists"}]
  },
  "capabilities": {
    "artifact-registration-clients": [
      {"source": "tools/identity/artifact_reference.py", "target": ".ai/foundation/reference_clients/artifact_reference.py", "kind": "reference-client", "merge": "review_if_exists"},
      {"source": "tools/identity/ArtifactReference.ps1", "target": ".ai/foundation/reference_clients/ArtifactReference.ps1", "kind": "reference-client", "merge": "review_if_exists"}
    ]
  },
  "never_transfer": [
    "README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", ".gitignore",
    ".ai/PROJECT_CONTEXT.md", ".ai/FOUNDATION.md", ".ai/PROJECT_STATUS.md", ".ai/HANDOVER.md", ".ai/BACKLOG.md", ".ai/ROADMAP.md", ".ai/TOOL_ADAPTERS.yaml", ".ai/repo_map.yaml",
    "Documentation/Architecture/", "Documentation/Quality/",
    "tools/bootstrap.py", "tools/install_foundation.py", "tools/foundation_validator.py", "tools/transfer_manifest_guard.py", "tests/"
  ]
}
